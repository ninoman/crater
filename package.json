{
  "name": "crater",
  "private": true,
  "license": "MIT",
  "version": "0.7.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "perf": "vitest run --config tests/perf/vitest.config.ts",
    "eval": "tsx tests/eval/deepCuts.ts",
    "fixtures:refresh": "tsx scripts/refresh-fixtures.ts",
    "release:build": "tsx scripts/release.ts",
    "storage:estimate": "tsx scripts/estimate-storage.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "dexie": "4.4.6",
    "dexie-export-import": "4.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
