{
  "name": "dighead",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "perf": "vitest run --config tests/perf/vitest.config.ts",
    "fixtures:refresh": "tsx scripts/refresh-fixtures.ts"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
